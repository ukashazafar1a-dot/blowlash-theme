<div
  class="single_slide carousel-cell hero-media-wrapper"
  data-slide="{{ block.id }}"
  data-start-time="{{ startTime }}"
  data-end-time="{{ endTime }}"
  data-current-time="{{ timeNow }}"
  data-show-slide="{{ showSlide }}"
  {{ block.shopify_attributes }}
>
<style>
  .custom_btn_1-{{ block.id }} {
    background-color: {{ block.settings.btn_bg_1 }};
    color: {{ block.settings.btn_clr_1 }};
  }
  .custom_btn_1-{{ block.id }}:hover {
    background-color: {{ block.settings.btn_hover_bg_1 }};
    color: {{ block.settings.btn_hover_clr_1 }};
  }

  .custom_btn_2-{{ block.id }} {
    background-color: {{ block.settings.btn_bg_2 }};
    color: {{ block.settings.btn_clr_2 }};
  }
  .custom_btn_2-{{ block.id }}:hover {
    background-color: {{ block.settings.btn_hover_bg_2 }};
    color: {{ block.settings.btn_hover_clr_2 }};
  }
</style>
  {% if block.settings.link != blank %}<a href="{{ block.settings.link }}">{% endif %}
  {% render 'rf-slider-image', image: block.settings.image, mobile_image: block.settings.image_mobile %}
  {% if block.settings.link != blank %}</a>{% endif %}
  {% if block.settings.btn_url1 != blank or block.settings.btn_url2 != blank %}
    <div class="btn_slide">
      {% if block.settings.btn_url1 != blank %}
        <a
          href="{{ block.settings.btn_url1 }}"
          class="btn btn_custom custom_btn_1-{{ block.id }}"
          
        >
          {{- block.settings.btn_text_1 -}}
        </a>
      {% endif -%}
      {% if block.settings.btn_url2 != blank %}
        <a
          href="{{ block.settings.btn_url2 }}"
          class="btn btn_custom custom_btn_2-{{ block.id }}"
          
        >
          {{- block.settings.btn_text_2 -}}
        </a>
      {% endif -%}
    </div>
  {% endif %}
  {% if block.settings.title != blank or block.settings.description != blank or block.settings.hreftitle != blank %}
    <div class="content_information_wrap">
      {% if block.settings.title != blank %}
        <div class="content_title-rf h1 ">{{ block.settings.title }}</div>
      {% endif %}
      {% if block.settings.description != blank %}
        <p class="rf-description">
          {{ block.settings.description }}
        </p>
      {% endif %}
      {% if block.settings.hreftitle != blank %}
        <a class="button button--primary" href="{{ block.settings.link }}">{{ block.settings.hreftitle }}</a>
      {% endif %}
    </div>
  {% endif %}
</div>