<div class="image-with-text__media-item ">
  {%- if mobile_image != blank -%}
    <div
      class="desktop_img image-wrap"
      {% if image != blank %}
        style="height:0;padding-bottom: {{ 1 | divided_by: image.aspect_ratio | times: 100 }}%;"
      {% endif %}
    >
      {%- capture sizes -%}min({{ settings.styles_max_width }}px, 100vw){%- endcapture -%}
      {% if image != blank %}
        {{ image | image_url: width: 2800 | image_tag: is: 'loess-image', reveal: true }}
      {%- else -%}
        {{ 'lifestyle-1' | placeholder_svg_tag }}
      {%- endif -%}
    </div>
    <div
      class="mobile_img image-wrap"
      {% if mobile_image != blank %}
        style="height:0;padding-bottom: {{ 1 | divided_by: mobile_image.aspect_ratio | times: 100 }}%;"
      {% endif %}
    >
      {% assign mobileClasses = 'mobile_img image-wrap' %}
      {%- capture sizes -%}min({{ settings.styles_max_width }}px, 100vw){%- endcapture -%}
      {% if mobile_image != blank %}
        {{-
          mobile_image
          | image_url: width: mobile_image.width
          | image_tag:
            sizes: sizes,
            widths: '200,300,400,500,600,700,800,900,1000,1200,1400,1600,1800,2000,2200,2400,2600,2800,3000,3200'
        -}}
      {%- else -%}
        {{ 'lifestyle-1' | placeholder_svg_tag }}
      {%- endif -%}
    </div>
  {% else %}
    <div
      class="image-wrap"
      {% if image != blank %}
        style="height:0;padding-bottom: {{ 1 | divided_by: image.aspect_ratio | times: 100 }}%;"
      {% endif %}
    >
      {%- capture sizes -%}min({{ settings.styles_max_width }}px, 100vw){%- endcapture -%}
      {% if image != blank %}
        {{ image | image_url: width: 2800 | image_tag: is: 'loess-image', reveal: true }}
      {%- else -%}
        {{ 'lifestyle-1' | placeholder_svg_tag }}
      {%- endif -%}
    </div>
  {% endif %}
</div>