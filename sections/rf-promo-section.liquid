{% stylesheet %}
.rf-promo-section {
  display: flex;
  flex-wrap: wrap;
  gap: {{ section.settings.gap }}px;
}

.rf-promo-block {
  flex: 1 1 48%;
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
  padding: 20px;
}

.rf-promo-block img {
  width: 100%;
  margin-bottom: 1rem;
}

.rf-promo-block h2 {
  margin-bottom: 0.5rem;
}

.rf-promo-block p {
  margin-bottom: 1rem;
}

.rf-promo-block a {
  text-decoration: none;
  border-radius: 6px;
  padding: 8px 16px;
}

@media screen and (max-width: 768px) {
  .rf-promo-section {
    flex-direction: column;
  }
  
  .rf-promo-block {
    flex: 1 1 100%;
  }
}
{% endstylesheet %}

<div class="rf-promo-section">
  {% for block in section.blocks %}
    <div class="rf-promo-block" style="
      background-color: {{ block.settings.rf_background_color }};
      padding-top: {{ block.settings.padding_top }}px;
      padding-right: {{ block.settings.padding_right }}px;
      padding-bottom: {{ block.settings.padding_bottom }}px;
      padding-left: {{ block.settings.padding_left }}px;
    ">
      {% if block.settings.text_position == 'top' %}
        <h2 style="
          font-size: {{ block.settings.heading_font_size }}px;
          color: {{ block.settings.heading_color }};
        ">{{ block.settings.heading }}</h2>
        <p style="
          font-size: {{ block.settings.text_font_size }}px;
          color: {{ block.settings.text_color }};
        ">{{ block.settings.subheading }}</p>
        {% if block.settings.image != blank %}
          <img 
            src="{{ block.settings.image | img_url: '720x' }}" 
            alt="{{ block.settings.heading }}"
            style="border-radius: {{ block.settings.image_border_radius }}px;"
          >
        {% endif %}
      {% else %}
        {% if block.settings.image != blank %}
          <img 
            src="{{ block.settings.image | img_url: '720x' }}" 
            alt="{{ block.settings.heading }}"
            style="border-radius: {{ block.settings.image_border_radius }}px;"
          >
        {% endif %}
        <h2 style="
          font-size: {{ block.settings.heading_font_size }}px;
          color: {{ block.settings.heading_color }};
        ">{{ block.settings.heading }}</h2>
        <p style="
          font-size: {{ block.settings.text_font_size }}px;
          color: {{ block.settings.text_color }};
        ">{{ block.settings.subheading }}</p>
      {% endif %}
      {% if block.settings.link != blank %}
        <a href="{{ block.settings.link }}" style="
          padding-top: {{ block.settings.button_padding_top }}px;
          padding-bottom: {{ block.settings.button_padding_top }}px;
          padding-left: {{ block.settings.button_padding_sides }}px;
          padding-right: {{ block.settings.button_padding_sides }}px;
          background-color: {{ block.settings.button_bg_color }};
          color: {{ block.settings.button_text_color }};
          border-radius: {{ block.settings.button_border_radius }}px;
        ">{{ block.settings.button_text }}</a>
      {% endif %}
    </div>
  {% endfor %}
</div>

{% schema %}
{
  "name": "RF-Promo Section",
  "settings": [
    {
      "type": "range",
      "id": "gap",
      "label": "Gap Between Blocks (px)",
      "min": 0,
      "max": 100,
      "default": 20
    },
  ],
  "blocks": [
    {
      "type": "promo_block",
      "name": "Promo Block",
      "settings": [
        { 
          "type": "text", 
          "id": "heading", 
          "label": "Heading", 
          "default": "Block Title"  
        },
        { 
          "type": "textarea", 
          "id": "subheading", 
          "label": "Subheading", 
          "default": "Block description goes here." 
        },
        { 
          "type": "url", 
          "id": "link", 
          "label": "Button URL" 
        },
        { 
          "type": "text", 
          "id": "button_text", 
          "label": "Button Text", 
          "default": "Shop Now" 
        },
        { 
          "type": "image_picker", 
          "id": "image", 
          "label": "Block Image" 
        },
        { 
          "type": "color", 
          "id": "rf_background_color", 
          "label": "Background Color", 
        },
        { 
          "type": "select", 
          "id": "text_position", 
          "label": "Text Position", 
          "options": [
            { "value": "top", "label": "Text above image" },
            { "value": "bottom", "label": "Text below image" }
          ],
          "default": "top"
        },
        { 
          "type": "color", 
          "id": "heading_color", 
          "label": "Heading Color", 
          "default": "#000000" 
        },
        { 
          "type": "color", 
          "id": "text_color", 
          "label": "Text Color", 
          "default": "#333333" 
        },
        { 
          "type": "range", 
          "id": "heading_font_size", 
          "label": "Heading Font Size (px)", 
          "min": 10, 
          "max": 80, 
          "default": 22 
        },
        { 
          "type": "range", 
          "id": "text_font_size", 
          "label": "Text Font Size (px)", 
          "min": 10, 
          "max": 80, 
          "default": 16 
        },
        { 
          "type": "range", 
          "id": "border_radius", 
          "label": "Block Border Radius (px)", 
          "min": 0, 
          "max": 50, 
          "default": 12 
        },
        { 
          "type": "color", 
          "id": "block_bg_color", 
          "label": "Block Background Color", 
          "default": "#ffffff" 
        },
        { 
          "type": "range", 
          "id": "image_border_radius", 
          "label": "Image Border Radius (px)", 
          "min": 0, 
          "max": 50, 
          "default": 12 
        },
        { 
          "type": "range", 
          "id": "padding_top", 
          "label": "Padding Top (px)", 
          "min": 0, 
          "max": 100, 
          "default": 20 
        },
        { 
          "type": "range", 
          "id": "padding_right", 
          "label": "Padding Right (px)", 
          "min": 0, 
          "max": 100, 
          "default": 20 
        },
        { 
          "type": "range", 
          "id": "padding_bottom", 
          "label": "Padding Bottom (px)", 
          "min": 0, 
          "max": 100, 
          "default": 20 
        },
        { 
          "type": "range", 
          "id": "padding_left", 
          "label": "Padding Left (px)", 
          "min": 0, 
          "max": 100, 
          "default": 20 
        },
        { 
          "type": "range", 
          "id": "button_padding_top", 
          "label": "Button Padding Top/Bottom (px)", 
          "min": 0, 
          "max": 50, 
          "default": 8 
        },
        { 
          "type": "range", 
          "id": "button_padding_sides", 
          "label": "Button Padding Left/Right (px)", 
          "min": 0, 
          "max": 50, 
          "default": 16 
        },
        { 
          "type": "range", 
          "id": "button_border_radius", 
          "label": "Button Border Radius (px)", 
          "min": 0, 
          "max": 50, 
          "default": 6 
        },
        { 
          "type": "color", 
          "id": "button_bg_color", 
          "label": "Button Background Color", 
          "default": "#3b65d1" 
        },
        { 
          "type": "color", 
          "id": "button_text_color", 
          "label": "Button Text Color", 
          "default": "#ffffff" 
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "RF-Promo Section",
      "category": "Custom",
      "blocks": [
        {
          "type": "promo_block"
        },
        {
          "type": "promo_block"
        }
      ]
    }
  ]
}
{% endschema %}