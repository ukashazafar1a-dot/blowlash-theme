<style>
  .rf-section-img-{{ section.id }} {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: {{ section.settings.rf_img_gap }}px;
    padding-top: {{ section.settings.rf_padding_top }}px;
    padding-bottom: {{ section.settings.rf_padding_bottom }}px;
  }

  .rf-img-block {
    position: relative;
    width: calc(50% - {{ section.settings.rf_img_gap }}px / 2);
    display: block;
    aspect-ratio: {{ section.settings.rf_img_aspect_ratio }};
    overflow: hidden;
  }

  .rf-img-block img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: {{ section.settings.rf_img_border_radius }}px;
  }

  .rf-img-text {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    display: flex;
    flex-direction: column;
    box-sizing: border-box;
    font-size: {{ section.settings.rf_text_size_2 }}px;
    line-height: 1.5;
    word-wrap: break-word !important;
    overflow-wrap: break-word !important;
    padding: 20px;
  }

  /* Vertical alignment classes */
  .rf-align-top {
    justify-content: flex-start;
  }
  
  .rf-align-center {
    justify-content: center;
  }
  
  .rf-align-bottom {
    justify-content: flex-end;
  }

  .rf-img-text p {
    margin: 0;
  }

  .rf-img-text a {
    display: inline-block;
    margin-top: 0;
    padding: 8px 18px;
    border-radius: 6px;
    text-decoration: none;
    font-weight: bold;
    font-size: {{ section.settings.rf_btn_text_size }}px;
    color: inherit;
  }

  .rf-img-text .rf-link-wrapper {
    width: 100%;
    display: flex;
  }

  .rf-img-text a:hover {
    cursor: pointer;
    text-decoration: underline;
    transition: 0.5s ease-in-out;
  }

  @media(max-width: 768px) {
    .rf-img-block {
      width: 100%;
      aspect-ratio: 1/1;
    }
  }
  /* Tablet: 769px to 1024px */
@media (min-width: 769px) and (max-width: 1024px) {
  .rf-section-img-{{ section.id }} {
    gap: {{ section.settings.rf_img_gap | divided_by: 2 }}px;
    padding-top: {{ section.settings.rf_padding_top | divided_by: 1.5 }}px;
    padding-bottom: {{ section.settings.rf_padding_bottom | divided_by: 1.5 }}px;
  }

  .rf-img-block {
    width: calc(50% - {{ section.settings.rf_img_gap | divided_by: 2 }}px / 2);
    /* Keep desktop aspect ratio, but allow slight scaling */
  }

  .rf-img-text {
    padding: 16px;
  }

  .rf-img-text h1 {
    font-size: {{ section.blocks[0].settings.rf_heading_size | at_most: 28 }}px !important;
  }

  .rf-img-text p {
    font-size: {{ section.blocks[0].settings.rf_text_size | at_most: 18 }}px !important;
  }

  .rf-img-text a {
    font-size: {{ section.settings.rf_btn_text_size | at_most: 18 }}px !important;
  }
}

/* Mobile: up to 768px */
@media (max-width: 768px) {
  .rf-section-img-{{ section.id }} {
    gap: {{ section.settings.rf_img_gap | divided_by: 2 }}px;
    padding-top: {{ section.settings.rf_padding_top | divided_by: 2 }}px;
    padding-bottom: {{ section.settings.rf_padding_bottom | divided_by: 2 }}px;
  }

  .rf-img-block {
    width: 100%;
    aspect-ratio: 1/1; /* or use {{ section.settings.rf_img_aspect_ratio }} if you prefer dynamic */
  }

  .rf-img-text {
    padding: 14px;
  }

  .rf-img-text h1 {
    font-size: {{ section.blocks[0].settings.rf_heading_size | divided_by: 1.4 | at_least: 18 }}px !important;
  }

  .rf-img-text p {
    font-size: {{ section.blocks[0].settings.rf_text_size | divided_by: 1.3 | at_least: 14 }}px !important;
  }

  .rf-img-text a {
    font-size: {{ section.settings.rf_btn_text_size | divided_by: 1.3 | at_least: 14 }}px !important;
    padding: 6px 14px;
  }
}
</style>

<div class="rf-section-img-{{ section.id }}">
  {% for block in section.blocks %}
    <div class="rf-img-block" {{ block.shopify_attributes }}>
      {% if block.settings.rf_section_img %}
        <img src="{{ block.settings.rf_section_img | img_url: 'master' }}" alt="{{ block.settings.rf_heading_text }}">
      {% endif %}
      <div class="rf-img-text rf-align-{{ block.settings.heading_vertical_alignment }}">
        {% if block.settings.rf_heading_text != blank %}
          <h1
            style="font-size:{{ block.settings.rf_heading_size }}px;color:{{ block.settings.rf_heading_color }};
            font-weight:{{ block.settings.heading_font_weight }};
            text-align:{{ block.settings.heading_text_alignment }};"
          >
            {{ block.settings.rf_heading_text }}
          </h1>
        {% endif %}
        
        {% if block.settings.rf_img_text != blank %}
          <p
            style="color: {{ block.settings.rf_para_color }};
            font-size:{{ block.settings.rf_text_size }}px;
            text-align:{{ block.settings.paragraph_text_alignment }};"
          >
            {{ block.settings.rf_img_text }}
          </p>
        {% endif %}
        
        {% if block.settings.rf_img_link != blank %}
          <div class="rf-link-wrapper" style="justify-content:{{ block.settings.Link_alignment }};">
            <a href="{{ block.settings.rf_img_link }}" style="color:{{ block.settings.rf_url_color }};">
              {{ block.settings.rf_link_text | default: 'Shop Now' }}
            </a>
          </div>
        {% endif %}
      </div>
    </div>
  {% endfor %}
</div>

{% schema %}
{
  "name": "RF Images Section",
  "settings": [
    {
      "type": "range",
      "id": "rf_padding_top",
      "label": "Padding Top",
      "min": 0,
      "max": 100,
      "unit": "px",
      "default": 20
    },
    {
      "type": "range",
      "id": "rf_padding_bottom",
      "label": "Padding Bottom",
      "min": 0,
      "max": 100,
      "unit": "px",
      "default": 20
    },
    {
      "type": "range",
      "id": "rf_img_gap",
      "label": "Image Gap",
      "min": 0,
      "max": 50,
      "unit": "px",
      "default": 20
    },
    {
      "type": "range",
      "id": "rf_img_border_radius",
      "label": "Image Border Radius",
      "min": 0,
      "max": 50,
      "unit": "px",
      "default": 0
    },
    {
      "type": "select",
      "id": "rf_img_aspect_ratio",
      "label": "Image Aspect Ratio",
      "options": [
        {"value": "1/3", "label": "1/3"},
        {"value": "2/3", "label": "2/3"},
        {"value": "3/3", "label": "3/3"},
        {"value": "4/3", "label": "4/3"},
        {"value": "5/3", "label": "5/3"}
      ],
      "default": "3/3"
    },
    {
      "type": "range",
      "id": "rf_btn_text_size",
      "label": "Button Font size",
      "min": 0,
      "max": 50,
      "unit": "px",
      "default": 20
    }
  ],
  "blocks": [
    {
      "type": "image_block",
      "name": "Image Block",
      "settings": [
        {
          "type": "image_picker",
          "id": "rf_section_img",
          "label": "Select Image"
        },
        {
          "type": "range",
          "id": "rf_heading_size",
          "label": "Heading Font size",
          "min": 10,
          "max": 100,
          "unit": "px",
          "default": 32
        },
        {
          "type": "color",
          "id": "rf_heading_color",
          "label": "Heading Color",
          "default": "#ffffff"
        },
        {
          "type": "text",
          "id": "rf_heading_text",
          "label": "Heading Text",
          "default": "Your Heading Here"
        },
        {
          "type": "select",
          "id": "heading_vertical_alignment",
          "label": "Heading Vertical Alignment",
          "options": [
            {"value": "top", "label": "Top"},
            {"value": "center", "label": "Center"},
            {"value": "bottom", "label": "Bottom"}
          ],
          "default": "center"
        },
        {
          "type": "select",
          "id": "heading_text_alignment",
          "label": "Heading Text Alignment",
          "options": [
            {"value": "left", "label": "Left"},
            {"value": "center", "label": "Center"},
            {"value": "right", "label": "Right"}
          ],
          "default": "center"
        },
        {
          "type": "select",
          "id": "heading_font_weight",
          "label": "Heading Font Weight",
          "options": [
            {"value": "400", "label": "Normal"},
            {"value": "500", "label": "Medium"},
            {"value": "600", "label": "Semi Bold"},
            {"value": "700", "label": "Bold"},
            {"value": "800", "label": "Extra Bold"},
            {"value": "900", "label": "Black"}
          ],
          "default": "700"
        },
        {
          "type": "range",
          "id": "rf_text_size",
          "label": "Paragraph Font size",
          "min": 10,
          "max": 50,
          "unit": "px",
          "default": 20
        },
        {
          "type": "color",
          "id": "rf_para_color",
          "label": "Paragraph Color",
          "default": "#ffffff"
        },
        {
          "type": "text",
          "id": "rf_img_text",
          "label": "Paragraph Text",
          "default": "Your paragraph text here"
        },
        {
          "type": "select",
          "id": "paragraph_text_alignment",
          "label": "Paragraph Text Alignment",
          "options": [
            {"value": "left", "label": "Left"},
            {"value": "center", "label": "Center"},
            {"value": "right", "label": "Right"}
          ],
          "default": "center"
        },
        {
          "type": "url",
          "id": "rf_img_link",
          "label": "Link URL"
        },
        {
          "type": "text",
          "id": "rf_link_text",
          "label": "Link Text",
          "default": "Shop Now"
        },
        {
          "type": "select",
          "id": "Link_alignment",
          "label": "Link Alignment",
          "options": [
            {"value": "flex-start", "label": "Left"},
            {"value": "center", "label": "Center"},
            {"value": "flex-end", "label": "Right"}
          ],
          "default": "center"
        },
        {
          "type": "color",
          "id": "rf_url_color",
          "label": "Link Text Color",
          "default": "#ffffff"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Image Blocks Section",
      "category": "Custom",
      "settings": {
        "rf_img_gap": 20,
        "rf_img_border_radius": 0,
        "rf_img_aspect_ratio": "3/3"
      },
      "blocks": [
        {
          "type": "image_block"
        },
        {
          "type": "image_block"
        }
      ]
    }
  ]
}
{% endschema %}